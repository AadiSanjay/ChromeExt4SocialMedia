{
  "name": "Hello Extensions",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms"
  ],
  "content_scripts": [
  {
    "matches": [
      "*://*.linkedin.com/*",
      "*://*.youtube.com/*",
      "*://*.instagram.com/*",
      "*://*.tiktok.com/*"
    ],
    "js": ["content.js"]
  }
]
}