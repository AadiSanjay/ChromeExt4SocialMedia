{
  "name": "FocusTicker",
  "description": "A subtle live timer that helps you stay aware of time spent on distracting websites.",
  "version": "1.0.0",
  "manifest_version": 3,
  
  "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
},

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms",
    "favicon"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.reddit.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.pinterest.com/*",
        "*://*.snapchat.com/*",
        "*://*.twitch.tv/*"
      ],
      "js": ["content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.reddit.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.pinterest.com/*",
        "*://*.snapchat.com/*",
        "*://*.twitch.tv/*"
      ]
    }
  ]
}